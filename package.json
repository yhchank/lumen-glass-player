{
  "name": "lumen-glass-player",
  "productName": "Lumen",
  "version": "1.1.3",
  "description": "Lumen — 液态玻璃风格 Windows 本地音乐播放器",
  "author": "Lumen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yhchank/lumen-glass-player.git"
  },
  "homepage": "https://github.com/yhchank/lumen-glass-player#readme",
  "bugs": {
    "url": "https://github.com/yhchank/lumen-glass-player/issues"
  },
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node scripts/start.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "pack": "npm run build && electron-builder --win --x64 --dir",
    "dist": "npm run build && electron-builder --win --x64",
    "icon": "python scripts/make-icon.py"
  },
  "dependencies": {
    "music-metadata": "^12.3.0"
  },
  "devDependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@ttqtt/liquid-glass-react": "^0.0.2",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^42.8.1",
    "electron-builder": "^26.18.0",
    "lucide-react": "^1.61.0",
    "playwright-core": "^1.58.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "com.lumen.glassplayer",
    "productName": "Lumen",
    "asar": true,
    "afterPack": "build/after-pack.cjs",
    "electronDist": "node_modules/electron/dist",
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "extraFiles": [
      {
        "from": "build/使用说明.txt",
        "to": "README.txt"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Lumen-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Lumen-${version}-Portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "流光 Lumen",
      "artifactName": "Lumen-Setup-${version}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": [
          "mp3",
          "m4a",
          "aac",
          "wav",
          "flac",
          "ogg",
          "opus"
        ],
        "name": "音频文件",
        "description": "使用流光 Lumen 播放",
        "role": "Viewer"
      }
    ]
  }
}
